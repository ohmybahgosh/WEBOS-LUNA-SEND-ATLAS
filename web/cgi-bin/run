#!/bin/sh
# CGI: run one luna-send call and return its reply as JSON.
# POST body is form-urlencoded: uri=<luna uri>&payload=<json>
# Served only on 127.0.0.1 by luna-atlas serve; the user reaches it over an SSH
# tunnel, so it runs as whatever luna-atlas runs as (root on a rooted TV).
printf 'Content-type: application/json\r\n\r\n'

urldecode() {
  s=$(printf '%s' "$1" | sed 's/+/ /g')
  printf '%b' "$(printf '%s' "$s" | sed 's/%\(..\)/\\x\1/g')"
}

if [ "${REQUEST_METHOD:-GET}" != "POST" ]; then
  printf '{"returnValue":false,"errorText":"POST only"}'; exit 0
fi
len=${CONTENT_LENGTH:-0}
body=$(dd bs=1 count="$len" 2>/dev/null)

uri=; payload='{}'
# split a&b=... on & then key=value
OLDIFS=$IFS; IFS='&'
for kv in $body; do
  k=${kv%%=*}; v=${kv#*=}
  case "$k" in
    uri) uri=$(urldecode "$v") ;;
    payload) payload=$(urldecode "$v") ;;
  esac
done
IFS=$OLDIFS

case "$uri" in
  luna://*) ;;
  *) printf '{"returnValue":false,"errorText":"bad or missing luna:// uri"}'; exit 0 ;;
esac
[ -n "$payload" ] || payload='{}'

if ! command -v luna-send >/dev/null 2>&1; then
  printf '{"returnValue":false,"errorText":"luna-send not found (run on the TV)"}'; exit 0
fi

out=$(luna-send -n 1 "$uri" "$payload" 2>&1)
# emit the reply as-is if it is already JSON, else wrap it
case "$out" in
  \{*) printf '%s' "$out" ;;
  *)   esc=$(printf '%s' "$out" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' ')
       printf '{"returnValue":false,"errorText":"%s"}' "$esc" ;;
esac
